program StrRealValues;
var
  r, x: Real; s: String; t: String[4]; u: String[12]; w, d: Integer; i: Integer; l: LongInt;
begin
  r := 1.5;
  Str(r:0:1, s);
  WriteLn('[', s, ']');
  Str(r:6:2, s);
  WriteLn('[', s, ']');
  Str(r:0:0, s);
  WriteLn('[', s, ']');
  Str(-r:0:3, s);
  WriteLn('[', s, ']');
  Str(r, s);
  WriteLn('[', s, ']', Length(s));
  Str(r:9, s);
  WriteLn('[', s, ']');
  Str(r:20, s);
  WriteLn('[', s, ']');
  Str(1234.5:0:1, s);
  WriteLn('[', s, ']');
  Str(0.25:8:2, s);
  WriteLn('[', s, ']');
  Str(r:0:1, t);
  WriteLn('[', t, ']');
  Str(1234.5:0:2, t);
  WriteLn('[', t, ']', Length(t));
  Str(-1000000.0:0:0, u);
  WriteLn('[', u, ']');
  Str(r * 1000000:0:0, u);
  WriteLn('[', u, ']');
  w := 10;
  d := 3;
  Str(0.125:w:d, s);
  WriteLn('[', s, ']');
  Str(0.125:w - 4:d - 1, s);
  WriteLn('[', s, ']');
  Str(Pi:0:5, s);
  WriteLn('[', s, ']');
  Str(Int(7.75):0:0, s);
  WriteLn('[', s, ']');
  i := 7;
  Str(i / 2:0:1, s);
  WriteLn('[', s, ']');
  l := 100000;
  Str(l * 3 / 4:0:0, s);
  WriteLn('[', s, ']');
  x := 0.0;
  Str(x:0:2, s);
  WriteLn('[', s, ']');
  Str(x, s);
  WriteLn('[', s, ']');
  Str(Sqrt(16.0):0:1, s);
  WriteLn('[', s, ']');
  Str(Round(2.6), s);
  WriteLn('[', s, ']');
  Str(Trunc(-2.6), s);
  WriteLn('[', s, ']');
  Str(1E10:0:0, s);
  WriteLn('[', s, ']')
end.
